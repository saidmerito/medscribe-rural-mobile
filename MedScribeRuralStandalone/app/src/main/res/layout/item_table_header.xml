<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="20dp"
    android:paddingHorizontal="12dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/textPhotoLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#26A69A"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1E1E1E"
        android:paddingVertical="6dp">

        <TextView style="@style/TableCellHeader" android:layout_width="0dp" android:layout_weight="1.1" android:text="@string/col_sexe" />
        <TextView style="@style/TableCellHeader" android:layout_width="0dp" android:layout_weight="1" android:text="@string/col_age" />
        <TextView style="@style/TableCellHeader" android:layout_width="0dp" android:layout_weight="1.6" android:text="@string/col_adresse" />
        <TextView style="@style/TableCellHeader" android:layout_width="0dp" android:layout_weight="1.8" android:text="@string/col_unite" />
        <TextView style="@style/TableCellHeader" android:layout_width="0dp" android:layout_weight="2.5" android:text="@string/col_motif" />
    </LinearLayout>
</LinearLayout>
