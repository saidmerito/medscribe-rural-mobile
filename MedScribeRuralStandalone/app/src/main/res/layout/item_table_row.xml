<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="4dp"
    android:paddingVertical="6dp"
    android:background="?attr/selectableItemBackground">

    <CheckBox
        android:id="@+id/checkboxSelect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp" />

    <TextView android:id="@+id/cellSexe" style="@style/TableCell" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.1" android:textIsSelectable="true" />
    <TextView android:id="@+id/cellAge" style="@style/TableCell" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textIsSelectable="true" />
    <TextView android:id="@+id/cellAdresse" style="@style/TableCell" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.6" android:textIsSelectable="true" />
    <TextView android:id="@+id/cellUnite" style="@style/TableCell" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.8" android:textIsSelectable="true" />
    <TextView android:id="@+id/cellMotif" style="@style/TableCell" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2.5" android:textIsSelectable="true" />
</LinearLayout>
