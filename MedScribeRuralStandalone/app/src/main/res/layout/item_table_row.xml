<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp"
    android:background="?attr/selectableItemBackground">

    <TextView android:id="@+id/cellSexe" style="@style/TableCell" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.1" />
    <TextView android:id="@+id/cellAge" style="@style/TableCell" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
    <TextView android:id="@+id/cellAdresse" style="@style/TableCell" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.6" />
    <TextView android:id="@+id/cellUnite" style="@style/TableCell" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.8" />
    <TextView android:id="@+id/cellMotif" style="@style/TableCell" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2.5" />
</LinearLayout>
